# FA2 Code for option 3
#   An experiment consists of rolling a die. Use R to simulate this experiment 600 times and obtain the relative frequency
# of each possible outcome. Hence, estimate the probability of getting each 1, 2, 3, 4, 5, and 6.

# number of times the die will be rolled
n <- 600


# simulate rolling a fair six-sided die "n" times
rolls <- sample(1:6, size = n, replace = TRUE)
 
 
# view the first few rolls to check if it worked 
head(rolls)
========================
[1] 6 5 5 1 4 6
========================


# count how many times each number (1-6) appeared
counts <- table(rolls)
counts
============================
rolls
  1   2   3   4   5   6 
 91 100 102  96  99 112 
============================


# calculate the relative frequency of each outcome
relative_freq <- counts / n


# put it in a table
results_table <- data.frame(
   Outcome = 1:6,
   Frequency = as.vector(counts),
   Relative_Frequency = as.vector(relative_freq),
   Estimated_Probability = as.vector(relative_freq)
 )
results_table
============================================================
  Outcome Frequency Relative_Frequency Estimated_Probability
1       1        91          0.1516667             0.1516667
2       2       100          0.1666667             0.1666667
3       3       102          0.1700000             0.1700000
4       4        96          0.1600000             0.1600000
5       5        99          0.1650000             0.1650000
6       6       112          0.1866667             0.1866667
============================================================


# visualize the relative frequencies with a bar plot
bar_positions <- barplot(rel_freq,
         col = "skyblue",
         border = "black",
         xlab = "Outcome (Die Face)",
         ylab = "Relative Frequency",
         main = "Relative Frequency of Each Outcome (600 Rolls)",
         ylim = c(0, max(rel_freq) + 0.05))

text(x = bar_positions, 
      y = rel_freq + 0.01, 
      labels = round(rel_freq, 4))
